# BuisEase Backend Configuration
# Copy this file to .env and customize values as needed

# Secret key for JWT tokens (change in production)
JWT_SECRET_KEY=buisease-production-secret-key-replace-with-secure-random-value-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (Optional - for real email dispatch)
# Leave as dummy or leave unset to use development fallback mode
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME="BuisEase Support"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
